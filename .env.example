# ===== Server =====
NODE_ENV=development
SERVER_PORT=4000
WEB_ORIGIN=http://localhost:3000

# ===== Database =====
DATABASE_URL=postgresql://agenthub:agenthub@localhost:5432/agenthub
REDIS_URL=redis://localhost:6379

# ===== Object storage (MinIO local / S3) =====
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=agenthub
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ===== Auth =====
AUTH_SECRET=change-me-in-prod
INVITE_CODE=agenthub-demo

# ===== Adapter keys (fill what you have; mock works without any) =====
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DOUBAO_API_KEY=
DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3

# ===== Sandbox =====
SANDBOX_PROVIDER=mock        # mock | e2b | docker | webcontainer
E2B_API_KEY=

# ===== Deploy =====
VERCEL_TOKEN=
CLOUDFLARE_API_TOKEN=

# ===== Observability =====
# Get keys at https://cloud.langfuse.com → Settings → API keys.
# When both keys are blank, tracing is silently disabled (no-op).
# Self-hosted? Point LANGFUSE_HOST to your instance.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== Anonymous preview share link =====
PREVIEW_SHARE_SECRET=rotate-me
PREVIEW_SHARE_TTL_HOURS=24
