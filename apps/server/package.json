{
  "name": "@agenthub/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register --watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@agenthub/adapter-claude-code": "workspace:*",
    "@agenthub/adapter-codex": "workspace:*",
    "@agenthub/adapter-core": "workspace:*",
    "@agenthub/adapter-deepseek": "workspace:*",
    "@agenthub/adapter-doubao": "workspace:*",
    "@agenthub/adapter-mock": "workspace:*",
    "@agenthub/db": "workspace:*",
    "@agenthub/prompts": "workspace:*",
    "@agenthub/shared-types": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-ws": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "bullmq": "^5.34.5",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^7.2.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.10",
    "@swc/core": "^1.10.6",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
